name: sample

# Shape 4: a 40-character commit SHA and no version comment. It resolves to
# exactly one tree, which is the whole point, and no human reading this file
# can tell whether that tree is last week's release or one from 2019.
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - uses: actions/setup-node@39370e3970a6d050c480ffad4ff0ed4d3fdee5af
        with:
          node-version: 22
