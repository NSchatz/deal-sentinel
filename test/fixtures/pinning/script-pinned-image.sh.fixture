#!/usr/bin/env bash
#
# The same script, pinned everywhere it names an image - documentation block
# included. Nothing here may be reported, or the check is refusing everything.
#
# Environment:
#   SAMPLE_PG_IMAGE        default
#                          postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
set -euo pipefail

image="${SAMPLE_PG_IMAGE:-redis:7-alpine@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef}"

docker run --rm \
  --user "$(id -u):$(id -g)" \
  -v "${PWD}:/work" \
  busybox:1.37@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef \
  sh -c 'exec true'

# A libpq URL is not an image reference and must not be read as one.
echo "postgres://sentinel:***@127.0.0.1:5432/deal_sentinel_history $image"
