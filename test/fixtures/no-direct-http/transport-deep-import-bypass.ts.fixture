// The next thing somebody tries once the public export is gone: reach past the
// package entry point into the module the factory lives in. Two rules catch
// this file - the module import and the identifier - and either alone would be
// enough.

import * as internals from "../../governor/src/transport.ts";

export async function priceOf(url: string): Promise<string> {
  const response = await internals.createFetchTransport().send({
    url,
    method: "GET",
    headers: {},
    timeoutMs: 5000,
    maxBytes: 1048576,
  });
  return response.body;
}
