{
  "name": "deal-sentinel",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted price watcher for the homelab. HISTORY-1: the observation record, the durable store, and fixtures.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"packages/*/test/**/*.test.ts\" \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --test \"packages/*/test/**/*.test.ts\" \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "governor:start-check": "node packages/governor/src/cli/start-check.ts",
    "sources:start-check": "node packages/sources/src/cli/start-check.ts",
    "db:generate": "pnpm --dir packages/db exec drizzle-kit generate",
    "db:init": "node packages/db/src/cli/init.ts",
    "db:start-check": "node packages/db/src/cli/start-check.ts",
    "db:backup": "bash packages/db/scripts/backup.sh",
    "db:restore": "bash packages/db/scripts/restore.sh"
  },
  "devDependencies": {
    "@deal-sentinel/db": "*",
    "@deal-sentinel/extractor": "*",
    "@deal-sentinel/governor": "*",
    "@deal-sentinel/shared": "*",
    "@deal-sentinel/sources": "*",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1",
    "pg": "8.13.1",
    "typescript": "5.7.2"
  }
}
